# Copy to deploy/.env and fill in. deploy/.env is git-ignored.

# Hostname the app is served on; point it at the server's LAN IP in UniFi local DNS
COFFEE_HOST=coffee.example.com

# Let's Encrypt account email
ACME_EMAIL=you@example.com

# Cloudflare API token with Zone → DNS → Edit, limited to this zone
CLOUDFLARE_API_TOKEN=

# Optional: where the database and photos live on the host (default ../data)
# COFFEE_DATA=/srv/coffee-data

# Optional: Ollama endpoint for label extraction (M1)
# OLLAMA_HOST=http://host.docker.internal:11434
